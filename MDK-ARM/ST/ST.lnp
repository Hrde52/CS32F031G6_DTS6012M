"st\stm32f0xx_hal_rcc_ex.o"
"st\stm32f0xx_hal.o"
"st\stm32f0xx_hal_i2c.o"
"st\stm32f0xx_hal_i2c_ex.o"
"st\stm32f0xx_hal_gpio.o"
"st\stm32f0xx_hal_dma.o"
"st\stm32f0xx_hal_cortex.o"
